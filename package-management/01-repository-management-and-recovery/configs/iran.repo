# Official Rocky Linux Iran Mirror

[iran-baseos]
name=IUT Rocky Linux $releasever - BaseOS - Iran Mirror
baseurl=https://repo.iut.ac.ir/repo/rocky-linux/$releasever/BaseOS/$basearch/os/
gpgcheck=1
enabled=0
countme=1
metadata_expire=6h
gpgkey=https://repo.iut.ac.ir/repo/rocky-linux/RPM-GPG-KEY-Rocky-9

[iran-appstream]
name=IUT Rocky Linux $releasever - AppStream - Iran Mirror
baseurl=https://repo.iut.ac.ir/repo/rocky-linux/$releasever/AppStream/$basearch/os/
gpgcheck=1
enabled=0
countme=1
metadata_expire=6h
gpgkey=https://repo.iut.ac.ir/repo/rocky-linux/RPM-GPG-KEY-Rocky-9

[iran-crb]
name=IUT Rocky Linux $releasever - CRB - Iran Mirro
baseurl=https://repo.iut.ac.ir/repo/rocky-linux/$releasever/CRB/$basearch/os/
gpgcheck=1
enabled=0
countme=1
metadata_expire=6h
gpgkey=https://repo.iut.ac.ir/repo/rocky-linux/RPM-GPG-KEY-Rocky-9

[iran-extras]
name=IUT Rocky Linux $releasever - Extras - Iran Mirror
baseurl=https://repo.iut.ac.ir/repo/rocky-linux/$releasever/extras/$basearch/os/
gpgcheck=1
enabled=0
countme=1
metadata_expire=6h
gpgkey=https://repo.iut.ac.ir/repo/rocky-linux/RPM-GPG-KEY-Rocky-9

# Epel Iran Mirror

[iran-epel]
